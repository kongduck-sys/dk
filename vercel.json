{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "mkdir -p public && cp index.html admin.html public/ && cp -r images public/",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/_adm",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/_adm/:path*",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/event_detail.php",
      "has": [
        {
          "type": "query",
          "key": "CODE",
          "value": "(?<code>\\d+)"
        }
      ],
      "destination": "/api/content?legacy_event=:code",
      "permanent": false
    },
    {
      "source": "/event_detail.php",
      "destination": "/#/event",
      "permanent": false
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/introduction.php",
      "destination": "/#/introduction",
      "permanent": false
    },
    {
      "source": "/setsus_apart.php",
      "destination": "/#/setsus_apart",
      "permanent": false
    },
    {
