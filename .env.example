# ------------------------------------------------------------
# Vercel 환경변수 (vercel env add 이름) — 실제 값은 절대 파일로 커밋하지 마세요
# ------------------------------------------------------------

# Supabase 트랜잭션 풀러(IPv4, 서버리스용) 접속 문자열
# Supabase 대시보드 → Project Settings → Database → Connection string → Transaction pooler 에서 복사
# 비밀번호 특수문자는 URL 인코딩 필요 (예: ! → %21)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres

# 관리자 로그인 JWT 서명 키 — 32자 이상 무작위 문자열
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 바꾸면 모든 관리자 로그인이 즉시 해제됩니다.
JWT_SECRET=[RANDOM_48_BYTES]
